{% liquid
  assign fallback_banner_image = 'https://cdn.shopify.com/s/files/1/0749/7007/1208/files/young-man-in-bright-fashion_925x_b3b7ebd6-c91f-496a-a516-45403497ea25.jpg?v=1777282900'
  assign banner_alt = section.settings.banner_alt | default: section.settings.title
%}

<section
  class="custom-hero-banner"
  style="
    --custom-hero-panel-background: {{ section.settings.panel_background_color }};
    --custom-hero-bg-color: {{ section.settings.banner_bg_color }};
    --custom-hero-panel-max-width: {{ section.settings.panel_max_width }}px;
    --custom-hero-title-color: {{ section.settings.title_color }};
    --custom-hero-title-size: {{ section.settings.title_font_size }}px;
    --custom-hero-title-size-mobile: {{ section.settings.title_font_size_mobile }}px;
    --custom-hero-title-weight: {{ section.settings.title_font_weight }};
    --custom-hero-title-line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
    --custom-hero-description-color: {{ section.settings.description_color }};
    --custom-hero-description-size: {{ section.settings.description_font_size }}px;
    --custom-hero-description-size-mobile: {{ section.settings.description_font_size_mobile }}px;
    --custom-hero-description-weight: {{ section.settings.description_font_weight }};
    --custom-hero-description-line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    --custom-hero-button-size: {{ section.settings.button_font_size }}px;
    --custom-hero-button-size-mobile: {{ section.settings.button_font_size_mobile }}px;
    --custom-hero-button-weight: {{ section.settings.button_font_weight }};
    --custom-hero-button-line-height: {{ section.settings.button_line_height | divided_by: 100.0 }};
  "
>
  <div class="custom-hero-banner__media"{% if section.settings.banner_image == blank %} style="background-color: var(--custom-hero-bg-color);" {% endif %}>
    {% if section.settings.banner_image != blank %}
      {{
        section.settings.banner_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: banner_alt,
          class: 'custom-hero-banner__image custom-hero-banner__image--desktop',
          fetchpriority: 'high'
      }}
    {% else %}
      <img
        src="{{ fallback_banner_image }}"
        alt="{{ banner_alt | escape }}"
        class="custom-hero-banner__image custom-hero-banner__image--desktop"
        width="925"
        height="617"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}

    {% if section.settings.mobile_banner_image != blank %}
      {{
        section.settings.mobile_banner_image
        | image_url: width: 1200
        | image_tag:
          widths: '375, 550, 750, 950, 1200',
          sizes: '100vw',
          alt: banner_alt,
          class: 'custom-hero-banner__image custom-hero-banner__image--mobile',
          loading: 'eager'
      }}
    {% endif %}
  </div>

  <div class="custom-hero-banner__content custom-hero-banner__content--{{ section.settings.content_position }}">
    <div class="custom-hero-banner__panel">
      {% if section.settings.title != blank %}
        <h2 class="custom-hero-banner__title">
          {{ section.settings.title | escape }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="custom-hero-banner__description">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          class="custom-hero-banner__button custom-hero-banner__button--{{ section.settings.button_style }}"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          <span>{{ section.settings.button_text | escape }}</span>
          <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-hero-banner {
    position: relative;
    isolation: isolate;
    min-height: clamp(520px, calc(100svh - var(--header-group-height, 0px)), 820px);
    overflow: hidden;
  }

  .custom-hero-banner__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .custom-hero-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .custom-hero-banner__image--mobile {
    display: none;
  }

  .custom-hero-banner__content {
    display: flex;
    min-height: inherit;
    padding: clamp(24px, 4vw, 56px);
  }

  .custom-hero-banner__content--left-top {
    align-items: flex-start;
    justify-content: flex-start;
  }

  .custom-hero-banner__content--left-center {
    align-items: center;
    justify-content: flex-start;
  }

  .custom-hero-banner__content--left-bottom {
    align-items: flex-end;
    justify-content: flex-start;
  }

  .custom-hero-banner__content--center-top {
    align-items: flex-start;
    justify-content: center;
  }

  .custom-hero-banner__content--center-center {
    align-items: center;
    justify-content: center;
  }

  .custom-hero-banner__content--center-bottom {
    align-items: flex-end;
    justify-content: center;
  }

  .custom-hero-banner__content--right-top {
    align-items: flex-start;
    justify-content: flex-end;
  }

  .custom-hero-banner__content--right-center {
    align-items: center;
    justify-content: flex-end;
  }

  .custom-hero-banner__content--right-bottom {
    align-items: flex-end;
    justify-content: flex-end;
  }

  .custom-hero-banner__panel {
    width: min(100%, var(--custom-hero-panel-max-width));
    padding: 24px;
    background-color: var(--custom-hero-panel-background);
  }

  .custom-hero-banner__title,
  .custom-hero-banner__description {
    margin: 0;
    letter-spacing: 0;
  }

  .custom-hero-banner__title {
    color: var(--custom-hero-title-color);
    font-size: var(--custom-hero-title-size);
    font-weight: var(--custom-hero-title-weight);
    line-height: var(--custom-hero-title-line-height);
  }

  .custom-hero-banner__description {
    margin: 32px 0;
    color: var(--custom-hero-description-color);
    font-size: var(--custom-hero-description-size);
    font-weight: var(--custom-hero-description-weight);
    line-height: var(--custom-hero-description-line-height);
  }

  .custom-hero-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    margin-block-start: 24px;
    padding: 12px 24px;
    background-color: var(--custom-hero-button-bg);
    color: var(--custom-hero-button-text);
    font-size: var(--custom-hero-button-size);
    font-weight: var(--custom-hero-button-weight);
    line-height: var(--custom-hero-button-line-height);
    text-align: center;
    text-decoration: none;
    transition: color var(--animation-speed) var(--animation-easing),
      background-color var(--animation-speed) var(--animation-easing);
  }

  .custom-hero-banner__button:hover {
    background-color: var(--custom-hero-button-hover-bg);
    color: var(--custom-hero-button-hover-text);
  }

  .custom-hero-banner__button--primary {
    --custom-hero-button-bg: #fff544;
    --custom-hero-button-text: #000000;
    --custom-hero-button-hover-bg: #000000;
    --custom-hero-button-hover-text: #ffffff;
  }

  .custom-hero-banner__button--secondary {
    --custom-hero-button-bg: #000000;
    --custom-hero-button-text: #ffffff;
    --custom-hero-button-hover-bg: #fff544;
    --custom-hero-button-hover-text: #000000;
  }

  .custom-hero-banner__button svg {
    flex-shrink: 0;
    width: 26px;
    height: 12px;
  }

  .custom-hero-banner__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .custom-hero-banner {
      display: flex;
      flex-direction: column-reverse;
      min-height: 0;
      overflow: visible;
      background-color: var(--custom-hero-panel-background);
    }

    .custom-hero-banner__media {
      position: relative;
      inset: auto;
      z-index: auto;
      overflow: hidden;
    }

    .custom-hero-banner__image--mobile {
      display: block;
    }

    .custom-hero-banner__image--mobile + .custom-hero-banner__image--desktop,
    .custom-hero-banner__media:has(.custom-hero-banner__image--mobile) .custom-hero-banner__image--desktop {
      display: none;
    }

    .custom-hero-banner__content {
      display: block;
      min-height: 0;
      padding: 28px 20px 24px;
      order: 2;
    }

    .custom-hero-banner__panel {
      width: 100%;
      padding: 0;
      background-color: transparent;
      text-align: center;
    }

    .custom-hero-banner__title {
      font-size: var(--custom-hero-title-size-mobile);
    }

    .custom-hero-banner__description {
      font-size: var(--custom-hero-description-size-mobile);
      margin: 16px 0 0;
    }

    .custom-hero-banner__button {
      position: absolute;
      bottom: 24px;
      left: 50%;
      z-index: 2;
      font-size: var(--custom-hero-button-size-mobile);
      margin-block-start: 0;
      transform: translateX(-50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "header",
      "content": "Banner image"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_banner_image",
      "label": "Mobile image"
    },
    {
      "type": "color",
      "id": "banner_bg_color",
      "label": "Banner Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "banner_alt",
      "label": "Image alt text",
      "default": "Young man in bright fashion"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "left-top",
          "label": "Left top"
        },
        {
          "value": "left-center",
          "label": "Left center"
        },
        {
          "value": "left-bottom",
          "label": "Left bottom"
        },
        {
          "value": "center-top",
          "label": "Center top"
        },
        {
          "value": "center-center",
          "label": "Center center"
        },
        {
          "value": "center-bottom",
          "label": "Center bottom"
        },
        {
          "value": "right-top",
          "label": "Right top"
        },
        {
          "value": "right-center",
          "label": "Right center"
        },
        {
          "value": "right-bottom",
          "label": "Right bottom"
        }
      ],
      "default": "left-bottom"
    },
    {
      "type": "header",
      "content": "Content box"
    },
    {
      "type": "color",
      "id": "panel_background_color",
      "label": "Background color",
      "alpha": true,
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "panel_max_width",
      "label": "Max width",
      "min": 280,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Text",
      "default": "The Gift Guide"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Font size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Mobile font size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 700
    },
    {
      "type": "range",
      "id": "title_line_height",
      "label": "Line height",
      "min": 90,
      "max": 180,
      "step": 5,
      "unit": "%",
      "default": 110
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Text",
      "default": "Discover gifts designed to feel personal, memorable, and easy to choose."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Font size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "description_font_size_mobile",
      "label": "Mobile font size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_font_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 400
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Line height",
      "min": 100,
      "max": 220,
      "step": 5,
      "unit": "%",
      "default": 145
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Text",
      "default": "SHOP GIFTS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "label": "Mobile font size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_font_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 600
    },
    {
      "type": "range",
      "id": "button_line_height",
      "label": "Line height",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "category": "Banners"
    }
  ]
}
{% endschema %}
