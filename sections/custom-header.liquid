<section
  class="custom-header"
  style="
    --custom-header-background: {{ section.settings.background_color }};
    --custom-header-logo-color: {{ section.settings.logo_color }};
    --custom-header-logo-size: {{ section.settings.logo_font_size }}px;
    --custom-header-logo-size-mobile: {{ section.settings.logo_font_size_mobile }}px;
    --custom-header-logo-weight: {{ section.settings.logo_font_weight }};
    --custom-header-logo-line-height: {{ section.settings.logo_line_height | divided_by: 100.0 }};
    --custom-header-logo-image-width: {{ section.settings.logo_image_width }}px;
    --custom-header-text-color: {{ section.settings.center_text_color }};
    --custom-header-text-size: {{ section.settings.center_text_font_size }}px;
    --custom-header-text-size-mobile: {{ section.settings.center_text_font_size_mobile }}px;
    --custom-header-text-weight: {{ section.settings.center_text_font_weight }};
    --custom-header-text-line-height: {{ section.settings.center_text_line_height | divided_by: 100.0 }};
    --custom-header-button-size: {{ section.settings.button_font_size }}px;
    --custom-header-button-size-mobile: {{ section.settings.button_font_size_mobile }}px;
    --custom-header-button-weight: {{ section.settings.button_font_weight }};
    --custom-header-button-line-height: {{ section.settings.button_line_height | divided_by: 100.0 }};
  "
>
  <div class="custom-header__inner custom-header__inner--{{ section.settings.section_width }}">
    {% if section.settings.center_text != blank or section.settings.button_text != blank %}
      <button
        type="button"
        class="custom-header__menu-toggle"
        aria-label="Open menu"
        aria-controls="CustomHeaderMenu-{{ section.id }}"
        aria-expanded="false"
        data-custom-header-toggle
      >
        <span class="custom-header__menu-line"></span>
        <span class="custom-header__menu-line"></span>
        <span class="custom-header__menu-line"></span>
      </button>
    {% endif %}

    {% if section.settings.logo_image != blank or section.settings.logo_text != blank %}
      <a
        class="custom-header__logo"
        href="{{ routes.root_url }}"
        aria-label="{{ section.settings.logo_text | default: shop.name | escape }}"
      >
        {% if section.settings.logo_image != blank %}
          {{
            section.settings.logo_image
            | image_url: width: 600
            | image_tag:
              widths: '120, 180, 240, 360, 480, 600',
              sizes: '(max-width: 749px) 160px, 220px',
              alt: section.settings.logo_text,
              class: 'custom-header__logo-image',
              loading: 'eager'
          }}
        {% else %}
          {{ section.settings.logo_text | escape }}
        {% endif %}
      </a>
    {% endif %}

    <div
      id="CustomHeaderMenu-{{ section.id }}"
      class="custom-header__menu"
      data-custom-header-menu
    >
      {% if section.settings.center_text != blank %}
        <p class="custom-header__text">
          {{ section.settings.center_text | escape }}
        </p>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          class="custom-header__button custom-header__button--{{ section.settings.button_style }}"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          <span>{{ section.settings.button_text | escape }}</span>
          <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-header {
    background-color: var(--custom-header-background);
  }

  .custom-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    min-height: 64px;
    max-height: 64px;
  }

  .custom-header__inner--page-width {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .custom-header__inner--full-width {
    padding-inline: var(--page-margin);
  }

  .custom-header__menu-toggle {
    display: none;
  }

  .custom-header__menu {
    display: contents;
  }

  .custom-header__logo,
  .custom-header__text,
  .custom-header__button {
    margin: 0;
    text-decoration: none;
  }

  .custom-header__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    color: var(--custom-header-logo-color);
    font-size: var(--custom-header-logo-size);
    font-weight: var(--custom-header-logo-weight);
    line-height: var(--custom-header-logo-line-height);
    letter-spacing: 0;
    white-space: nowrap;
  }

  .custom-header__logo-image {
    display: block;
    width: min(var(--custom-header-logo-image-width), 100%);
    height: auto;
  }

  .custom-header__text {
    justify-self: center;
    color: var(--custom-header-text-color);
    font-size: var(--custom-header-text-size);
    font-weight: var(--custom-header-text-weight);
    line-height: var(--custom-header-text-line-height);
    letter-spacing: 0;
    text-align: center;
  }

  .custom-header__button {
    width: 207px;
    height: 44px;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 12px 24px;
    background-color: var(--custom-header-button-bg);
    color: var(--custom-header-button-text);
    font-size: var(--custom-header-button-size);
    font-weight: var(--custom-header-button-weight);
    line-height: var(--custom-header-button-line-height);
    letter-spacing: 0;
    text-align: center;
    white-space: nowrap;
    transition: color var(--animation-speed) var(--animation-easing),
      background-color var(--animation-speed) var(--animation-easing);
  }

  .custom-header__button:hover {
    background-color: var(--custom-header-button-hover-bg);
    color: var(--custom-header-button-hover-text);
  }

  .custom-header__button--primary {
    --custom-header-button-bg: #fff544;
    --custom-header-button-text: #000000;
    --custom-header-button-hover-bg: #000000;
    --custom-header-button-hover-text: #ffffff;
  }

  .custom-header__button--secondary {
    --custom-header-button-bg: #000000;
    --custom-header-button-text: #ffffff;
    --custom-header-button-hover-bg: #fff544;
    --custom-header-button-hover-text: #000000;
  }

  .custom-header__button svg {
    flex-shrink: 0;
    width: 26px;
    height: 12px;
  }

  .custom-header__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .custom-header {
      position: relative;
    }

    .custom-header__inner {
      grid-template-columns: 44px minmax(0, 1fr) 44px;
      gap: 0;
      min-height: 64px;
      max-height: none;
      padding-block: 0;
      position: relative;
    }

    .custom-header__menu-toggle {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      background: transparent;
      color: #000000;
      cursor: pointer;
    }

    .custom-header__menu-line {
      display: block;
      width: 22px;
      height: 2px;
      background: currentColor;
      transform-origin: center;
      transition: opacity var(--animation-speed) var(--animation-easing),
        transform var(--animation-speed) var(--animation-easing);
    }

    .custom-header[data-menu-open='true'] .custom-header__menu-line:first-child {
      transform: translateY(7px) rotate(45deg);
    }

    .custom-header[data-menu-open='true'] .custom-header__menu-line:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }

    .custom-header[data-menu-open='true'] .custom-header__menu-line:last-child {
      transform: translateY(-7px) rotate(-45deg);
    }

    .custom-header__menu-toggle:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }

    .custom-header__logo {
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
      font-size: var(--custom-header-logo-size-mobile);
      text-align: center;
      white-space: normal;
    }

    .custom-header__menu {
      grid-column: 1 / -1;
      grid-row: 2;
      display: grid;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 16px;
      width: calc(100% + (var(--page-margin) * 2));
      max-height: 0;
      margin-inline: calc(var(--page-margin) * -1);
      padding: 0 var(--page-margin);
      overflow: hidden;
      background-color: #f2f2f2;
      opacity: 0;
      transform: translateY(-8px);
      transition: max-height 320ms var(--animation-easing),
        opacity var(--animation-speed) var(--animation-easing),
        padding-block 320ms var(--animation-easing),
        transform var(--animation-speed) var(--animation-easing);
    }

    .custom-header[data-menu-open='true'] .custom-header__menu {
      max-height: 240px;
      padding-block: 20px 24px;
      box-shadow: 0px 2px 4px 0px #00000026;
      opacity: 1;
      transform: translateY(0);
    }

    .custom-header__text,
    .custom-header__button {
      justify-self: center;
    }

    .custom-header__text {
      font-size: var(--custom-header-text-size-mobile);
      max-width: 280px;
    }

    .custom-header__button {
      font-size: var(--custom-header-button-size-mobile);
    }

    .custom-header__logo-image {
      max-height: 40px;
      object-fit: contain;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    const toggle = event.target.closest('[data-custom-header-toggle]');

    if (!toggle) return;

    const header = toggle.closest('.custom-header');
    const isOpen = header?.dataset.menuOpen === 'true';

    if (!header) return;

    header.dataset.menuOpen = isOpen ? 'false' : 'true';
    toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });
{% endjavascript %}

